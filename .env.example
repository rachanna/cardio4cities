ACCESS_CODE=            # shared with the panel
ADMIN_CODE=             # for the graph switch and planted cases
SESSION_SECRET=         # 32+ random bytes, base64
DATABASE_URL=           # postgresql://…  (local compose: postgresql://c4c:c4c@127.0.0.1:5432/c4c)
QDRANT_URL=             # local compose: http://127.0.0.1:6333
QDRANT_API_KEY=         # empty for local
NEO4J_URI=              # local compose: bolt://127.0.0.1:7687
NEO4J_USER=             # local compose: neo4j
NEO4J_PASSWORD=         # 8+ characters; local compose sets the Neo4j password from this
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=          # empty locally when search uses SearXNG
LANGSMITH_API_KEY=      # optional
SEARXNG_SECRET=         # local SearXNG only (BD-01); any random string
APP_ENV=local           # local | deployed
